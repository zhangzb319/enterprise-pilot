# ============================================================
#  Enterprise Pilot 环境变量模板
#  复制为 .env 或各子项目的 .env 后填写真实值
#  copy .env.example .env
# ============================================================

# MySQL 数据库连接地址（本地部署用 localhost，Docker 部署用 mysql）
DB_URL=jdbc:mysql://localhost:3306/enterprise_pilot?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# MySQL 用户名
DB_USERNAME=root

# MySQL 密码（请替换为真实密码）
DB_PASSWORD=your_password_here

# JWT 签名密钥（至少 32 字节，请替换为随机字符串）
JWT_SECRET=your_jwt_secret_at_least_32_bytes

# 智谱 AI API Key（用于知识库向量化与 AI 对话）
ZHIPU_API_KEY=your_zhipu_api_key_here

# Redis 主机地址（本地部署用 localhost，Docker 部署用 redis）
REDIS_HOST=localhost

# Redis 端口
REDIS_PORT=6379
